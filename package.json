{
    "name": "evo-front",
    "version": "11.0.11",
    "description": "Angular библиотека автоматизации работы frontend разработчика",
    "author": "Кургузов Владимир Геннадьевич <kurguzov74@gmail.com>",
    "license": "MIT",
    "sideEffects": false,
    "main": "bundles/evo-front.umd.js",
    "module": "fesm2015/evo-front.js",
    "es2015": "fesm2015/evo-front.js",
    "typings": "index.d.ts",
    "scripts": {
        "#LIB-BUILD": "npm run _delete-build && npm run _copy",
        "#BUILD:WATCH": "npm run build -- --watch",
        "###COPY-EVO-FRONT": "powershell -ExecutionPolicy Bypass -File ./copy-evo-front.ps1",
        "LIB-TO-NPM-PATCH": "npm run _delete-build && npm run _version-patch && npm run _copy-publish",
        "LIB-TO-NPM-MINOR": "npm run _delete-build && npm run _version-minor && npm run _copy-publish",
        "LIB-TO-NPM-MAJOR": "npm run _delete-build && npm run _version-major && npm run _copy-publish",
        "_delete": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmdirSync('dist', { recursive: true });\"",
        "_build-lib": "ng-packagr -p ng-package.json",
        "_delete-build": "npm run _delete && npm run _build-lib",
        "_copy": "node scripts/copy.js",
        "_version-major": "npm --no-git-tag-version version major",
        "_version-minor": "npm --no-git-tag-version version minor",
        "_version-patch": "npm --no-git-tag-version version patch",
        "_copy-publish": "npm run _copy && cd dist && npm publish --tag ng11-15",
        "lint": "eslint \"src/**/*.ts\"",
        "build": "ng-packagr -p ng-package.json"
    },
    "peerDependencies": {
        "@angular/core": ">=11 <16",
        "@angular/common": ">=11 <16",
        "rxjs": ">=6.5 <8"
    },
    "devDependencies": {
        "@angular/common": "11.2.14",
        "@angular/compiler": "11.2.14",
        "@angular/compiler-cli": "11.2.14",
        "@angular/core": "11.2.14",
        "@types/node": "14.14.37",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "chokidar": "^3.6.0",
        "eslint": "^8.57.0",
        "fs-extra": "^10.1.0",
        "ng-packagr": "^11.2.4",
        "npm-run-all": "^4.1.5",
        "rxjs": "^6.6.7",
        "tslib": "^2.0.0",
        "typescript": "~4.0.8"
    }
}
