{
    "compilerOptions": {
        "target": "ES2015",
        "module": "es2015",
        "moduleResolution": "node",
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strict": true,
        "typeRoots": [
            "./node_modules/@types",
            "./src"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts"
    ]
}
